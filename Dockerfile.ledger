FROM node:22-alpine
RUN apk add --no-cache libc6-compat openssl postgresql-client bash
WORKDIR /app
COPY package.json package-lock.json prisma.config.ts ./
COPY scripts/patch-next-ws-first-upgrade.mjs ./scripts/
RUN npm ci
COPY . .
RUN npx prisma generate
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=6144
RUN npm run build
RUN cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
CMD ["sh", "-c", "npx prisma migrate deploy && node .next/standalone/server.js"]
