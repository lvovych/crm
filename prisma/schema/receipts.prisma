model SupplierReceipt {
  id String @id @default(cuid())
  organizationId String
  supplierId String
  supplier Counterparty @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict)
  number String
  documentDate DateTime @db.Date
  receivedDate DateTime @db.Date
  currency String @default("UAH")
  status String @default("draft")
  version Int @default(1)
  createdById String
  createdAt DateTime @default(now())
  postedById String?
  postedAt DateTime?
  cancelledById String?
  cancelledAt DateTime?
  cancelReason String?
  source String @default("manual")
  sourceAccount String?
  externalId String?
  lines SupplierReceiptLine[]
  settlement SupplierEntry?
  @@unique([organizationId, supplierId, number, documentDate])
  @@unique([organizationId, source, sourceAccount, externalId])
  @@index([organizationId, receivedDate])
  @@map("supplier_receipts")
}
model SupplierReceiptLine {
  id String @id @default(cuid())
  receiptId String
  receipt SupplierReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  position Int
  kind String
  name String
  unit String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,4)
  amount Decimal @db.Decimal(18,2)
  article String?
  partId String?
  part InventoryPart? @relation(fields: [partId], references: [id], onDelete: Restrict)
  transfers ReceiptTransfer[]
  movements StockMovement[]
  @@unique([receiptId,position])
  @@map("supplier_receipt_lines")
}

model SupplierArticle {
  id String @id @default(cuid())
  organizationId String
  supplierId String
  supplier Counterparty @relation(fields:[organizationId,supplierId], references:[organizationId,id], onDelete:Cascade)
  article String
  normalized String
  partId String
  part InventoryPart @relation(fields:[partId],references:[id],onDelete:Cascade)
  @@unique([organizationId,supplierId,normalized])
  @@index([partId])
  @@map("supplier_articles")
}

/// Immutable history of goods sent from a receipt to a work order.
/// Work-order identifiers are snapshots, retained even if the order is deleted.
model ReceiptTransfer {
  id String @id @default(cuid())
  lineId String
  line SupplierReceiptLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  requestId String
  requestHash String
  serviceRecordId String
  serviceRecordLabel String
  vehicleId String?
  servicePartId String
  quantity Decimal @db.Decimal(14,3)
  unitPrice Decimal @db.Decimal(14,4)
  createdById String
  createdAt DateTime @default(now())
  @@unique([requestId, lineId])
  @@index([lineId])
  @@map("receipt_transfers")
}
