  moneyTransaction_party MoneyTransaction[] @relation("MoneyTransaction_party")
  settlementEntry_party  SettlementEntry[]  @relation("SettlementEntry_party")
  organization           Organization       @relation("LedgerOrgSettlementParty", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy              User?              @relation("LedgerActorSettlementParty", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, supplierId])
