model Supplier {
  supplierServiceDocument_supplier SupplierServiceDocument[] @relation("SupplierServiceDocument_supplier")

  purchaseOrder_supplier   PurchaseOrder[]   @relation("PurchaseOrder_supplier")
  ledgerImportJob_supplier LedgerImportJob[] @relation("LedgerImportJob_supplier")

  id                         String              @id @default(cuid())
  organizationId             String
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  createdById                String?
  name                       String
  normalizedName             String
  kind                       String              @default("GOODS")
  countryCode                String              @default("UA")
  taxId                      String?
  phone                      String?
  email                      String?
  address                    String?
  paymentTermsDays           Int                 @default(0)
  bankDetails                Json?
  notes                      String?
  archivedAt                 DateTime?           @db.Timestamptz(3)
  version                    Int                 @default(1)
  inventoryDocument_supplier InventoryDocument[] @relation("InventoryDocument_supplier")
  settlementParty_supplier   SettlementParty[]   @relation("SettlementParty_supplier")
  organization               Organization        @relation("LedgerOrgSupplier", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                  User?               @relation("LedgerActorSupplier", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@map("suppliers")
}

model Warehouse {
  purchaseOrder_warehouse PurchaseOrder[] @relation("PurchaseOrder_warehouse")

  stockReservation_warehouse      StockReservation[]      @relation("StockReservation_warehouse")
  documentLotAllocation_warehouse DocumentLotAllocation[] @relation("DocumentLotAllocation_warehouse")

  id                                String                 @id @default(cuid())
  organizationId                    String
  createdAt                         DateTime               @default(now()) @db.Timestamptz(3)
  createdById                       String?
  code                              String
  name                              String
  isDefault                         Boolean                @default(false)
  reservable                        Boolean                @default(true)
  archivedAt                        DateTime?              @db.Timestamptz(3)
  version                           Int                    @default(1)
  inventoryDocument_sourceWarehouse InventoryDocument[]    @relation("InventoryDocument_sourceWarehouse")
  inventoryDocument_targetWarehouse InventoryDocument[]    @relation("InventoryDocument_targetWarehouse")
  stockLotBalance_warehouse         StockLotBalance[]      @relation("StockLotBalance_warehouse")
  inventoryLedgerEntry_warehouse    InventoryLedgerEntry[] @relation("InventoryLedgerEntry_warehouse")
  organization                      Organization           @relation("LedgerOrgWarehouse", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                         User?                  @relation("LedgerActorWarehouse", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("warehouses")
}

model InventoryDocument {
  ledgerImportJob_document LedgerImportJob[] @relation("LedgerImportJob_document")

  id                                String                  @id @default(cuid())
  organizationId                    String
  createdAt                         DateTime                @default(now()) @db.Timestamptz(3)
  createdById                       String?
  number                            String
  kind                              String
  status                            String                  @default("DRAFT")
  effectiveAt                       DateTime                @db.Date
  postedAt                          DateTime?               @db.Timestamptz(3)
  externalNumber                    String?
  externalDate                      DateTime?               @db.Date
  dueDate                           DateTime?               @db.Date
  currency                          String                  @default("UAH") @db.Char(3)
  subtotal                          Decimal                 @default(0) @db.Decimal(20, 2)
  taxAmount                         Decimal                 @default(0) @db.Decimal(20, 2)
  totalAmount                       Decimal                 @default(0) @db.Decimal(20, 2)
  note                              String?
  version                           Int                     @default(1)
  supplierId                        String?
  supplier                          Supplier?               @relation("InventoryDocument_supplier", fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceWarehouseId                 String?
  sourceWarehouse                   Warehouse?              @relation("InventoryDocument_sourceWarehouse", fields: [organizationId, sourceWarehouseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  targetWarehouseId                 String?
  targetWarehouse                   Warehouse?              @relation("InventoryDocument_targetWarehouse", fields: [organizationId, targetWarehouseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceDocumentId                  String?
  sourceDocument                    InventoryDocument?      @relation("InventoryDocument_sourceDocument", fields: [organizationId, sourceDocumentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryDocument_sourceDocument  InventoryDocument[]     @relation("InventoryDocument_sourceDocument")
  inventoryDocumentLine_document    InventoryDocumentLine[] @relation("InventoryDocumentLine_document")
  settlementEntry_inventoryDocument SettlementEntry[]       @relation("SettlementEntry_inventoryDocument")
  organization                      Organization            @relation("LedgerOrgInventoryDocument", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                         User?                   @relation("LedgerActorInventoryDocument", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, effectiveAt, id])
  @@map("inventory_documents")
}

model InventoryDocumentLine {
  purchaseOrderLineId                 String?
  purchaseOrderLine                   PurchaseOrderLine?        @relation("InventoryDocumentLine_purchaseOrderLine", fields: [organizationId, purchaseOrderLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  receiptDemandAllocation_receiptLine ReceiptDemandAllocation[] @relation("ReceiptDemandAllocation_receiptLine")

  reservationEvent_documentLine      ReservationEvent[]      @relation("ReservationEvent_documentLine")
  documentLotAllocation_documentLine DocumentLotAllocation[] @relation("DocumentLotAllocation_documentLine")

  id                                String                 @id @default(cuid())
  organizationId                    String
  createdAt                         DateTime               @default(now()) @db.Timestamptz(3)
  createdById                       String?
  quantity                          Decimal                @db.Decimal(18, 3)
  unitPrice                         Decimal                @db.Decimal(20, 6)
  discountType                      String                 @default("NONE")
  discountValue                     Decimal                @default(0) @db.Decimal(20, 6)
  discountAmount                    Decimal                @db.Decimal(20, 2)
  taxMode                           String                 @default("NONE")
  taxRate                           Decimal                @default(0) @db.Decimal(6, 3)
  netAmount                         Decimal                @db.Decimal(20, 2)
  taxAmount                         Decimal                @db.Decimal(20, 2)
  totalAmount                       Decimal                @db.Decimal(20, 2)
  snapshotName                      String
  snapshotBrand                     String
  snapshotArticle                   String?
  snapshotUnit                      String
  sortOrder                         Int
  documentId                        String
  document                          InventoryDocument      @relation("InventoryDocumentLine_document", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryPartId                   String
  inventoryPart                     InventoryPart          @relation("InventoryDocumentLine_inventoryPart", fields: [organizationId, inventoryPartId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  stockLot_sourceLine               StockLot[]             @relation("StockLot_sourceLine")
  inventoryLedgerEntry_documentLine InventoryLedgerEntry[] @relation("InventoryLedgerEntry_documentLine")
  organization                      Organization           @relation("LedgerOrgInventoryDocumentLine", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                         User?                  @relation("LedgerActorInventoryDocumentLine", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, documentId])
  @@map("inventory_document_lines")
}

model StockLot {
  stockReservation_lot      StockReservation[]      @relation("StockReservation_lot")
  documentLotAllocation_lot DocumentLotAllocation[] @relation("DocumentLotAllocation_lot")

  id                       String                 @id @default(cuid())
  organizationId           String
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  createdById              String?
  acquiredAt               DateTime               @db.Date
  unitCost                 Decimal                @db.Decimal(20, 6)
  currency                 String                 @default("UAH") @db.Char(3)
  sourceLineId             String
  sourceLine               InventoryDocumentLine  @relation("StockLot_sourceLine", fields: [organizationId, sourceLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryPartId          String
  inventoryPart            InventoryPart          @relation("StockLot_inventoryPart", fields: [organizationId, inventoryPartId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  stockLotBalance_lot      StockLotBalance[]      @relation("StockLotBalance_lot")
  inventoryLedgerEntry_lot InventoryLedgerEntry[] @relation("InventoryLedgerEntry_lot")
  organization             Organization           @relation("LedgerOrgStockLot", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                User?                  @relation("LedgerActorStockLot", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceLineId])
  @@unique([organizationId, id])
  @@map("stock_lots")
}

model StockLotBalance {
  id             String       @id @default(cuid())
  organizationId String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  createdById    String?
  onHandQty      Decimal      @default(0) @db.Decimal(18, 3)
  reservedQty    Decimal      @default(0) @db.Decimal(18, 3)
  version        Int          @default(1)
  lotId          String
  lot            StockLot     @relation("StockLotBalance_lot", fields: [organizationId, lotId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  warehouseId    String
  warehouse      Warehouse    @relation("StockLotBalance_warehouse", fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  organization   Organization @relation("LedgerOrgStockLotBalance", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User?        @relation("LedgerActorStockLotBalance", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, lotId, warehouseId])
  @@unique([organizationId, id])
  @@map("stock_lot_balances")
}

model InventoryLedgerEntry {
  id              String                @id @default(cuid())
  organizationId  String
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  createdById     String?
  quantityDelta   Decimal               @db.Decimal(18, 3)
  costAmountDelta Decimal               @db.Decimal(20, 6)
  effectiveAt     DateTime              @db.Date
  operationKey    String
  lotId           String
