  warehouseId     String
  warehouse       Warehouse             @relation("InventoryLedgerEntry_warehouse", fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  documentLineId  String
  documentLine    InventoryDocumentLine @relation("InventoryLedgerEntry_documentLine", fields: [organizationId, documentLineId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  organization    Organization          @relation("LedgerOrgInventoryLedgerEntry", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User?                 @relation("LedgerActorInventoryLedgerEntry", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, operationKey])
  @@unique([organizationId, id])
  @@index([organizationId, lotId, warehouseId, effectiveAt])
  @@map("inventory_ledger_entries")
}

model SettlementParty {
  openingBalance_party OpeningBalance[] @relation("OpeningBalance_party")

  id                     String             @id @default(cuid())
  organizationId         String
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  createdById            String?
  kind                   String
  displayNameSnapshot    String
  supplierId             String?
  supplier               Supplier?          @relation("SettlementParty_supplier", fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  customerId             String?
