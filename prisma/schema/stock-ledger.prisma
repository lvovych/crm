model MoneyTransaction {
  reversalOfId                String?
  reversalOf                  MoneyTransaction?  @relation("MoneyTransaction_reversalOf", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  moneyTransaction_reversalOf MoneyTransaction[] @relation("MoneyTransaction_reversalOf")

  id                               String            @id @default(cuid())
  organizationId                   String
  createdAt                        DateTime          @default(now()) @db.Timestamptz(3)
  createdById                      String?
  direction                        String
  amount                           Decimal           @db.Decimal(20, 2)
  currency                         String            @default("UAH") @db.Char(3)
  effectiveAt                      DateTime          @db.Date
  method                           String
  note                             String?
  status                           String            @default("POSTED")
  version                          Int               @default(1)
  partyId                          String
  party                            SettlementParty   @relation("MoneyTransaction_party", fields: [organizationId, partyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  accountId                        String
  account                          CashAccount       @relation("MoneyTransaction_account", fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  cashLedgerEntry_moneyTransaction CashLedgerEntry[] @relation("CashLedgerEntry_moneyTransaction")
  settlementEntry_moneyTransaction SettlementEntry[] @relation("SettlementEntry_moneyTransaction")
  organization                     Organization      @relation("LedgerOrgMoneyTransaction", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                        User?             @relation("LedgerActorMoneyTransaction", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, effectiveAt, id])
  @@map("money_transactions")
}

model CashLedgerEntry {
