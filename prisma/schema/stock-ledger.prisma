model SettlementEntry {
  openingBalanceId           String?
  openingBalance             OpeningBalance?          @relation("SettlementEntry_openingBalance", fields: [organizationId, openingBalanceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  supplierServiceDocumentId  String?
  supplierServiceDocument    SupplierServiceDocument? @relation("SettlementEntry_supplierServiceDocument", fields: [organizationId, supplierServiceDocumentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  serviceRecordId            String?
  serviceRecord              ServiceRecord?           @relation("SettlementEntry_serviceRecord", fields: [organizationId, serviceRecordId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  reversalOfId               String?
  reversalOf                 SettlementEntry?         @relation("SettlementEntry_reversalOf", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  settlementEntry_reversalOf SettlementEntry[]        @relation("SettlementEntry_reversalOf")

  id                               String                 @id @default(cuid())
  organizationId                   String
  createdAt                        DateTime               @default(now()) @db.Timestamptz(3)
  createdById                      String?
  side                             String
  polarity                         String
  amount                           Decimal                @db.Decimal(20, 2)
  currency                         String                 @default("UAH") @db.Char(3)
  effectiveAt                      DateTime               @db.Date
  dueDate                          DateTime?              @db.Date
  operationKey                     String
  partyId                          String
  party                            SettlementParty        @relation("SettlementEntry_party", fields: [organizationId, partyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryDocumentId              String?
  inventoryDocument                InventoryDocument?     @relation("SettlementEntry_inventoryDocument", fields: [organizationId, inventoryDocumentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  moneyTransactionId               String?
  moneyTransaction                 MoneyTransaction?      @relation("SettlementEntry_moneyTransaction", fields: [organizationId, moneyTransactionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  settlementAllocation_debitEntry  SettlementAllocation[] @relation("SettlementAllocation_debitEntry")
  settlementAllocation_creditEntry SettlementAllocation[] @relation("SettlementAllocation_creditEntry")
  organization                     Organization           @relation("LedgerOrgSettlementEntry", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                        User?                  @relation("LedgerActorSettlementEntry", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, operationKey])
  @@unique([organizationId, id])
  @@index([organizationId, partyId, side, effectiveAt])
  @@map("settlement_entries")
}

model SettlementAllocation {
  allocationEvent_allocation AllocationEvent[] @relation("AllocationEvent_allocation")

  id             String          @id @default(cuid())
